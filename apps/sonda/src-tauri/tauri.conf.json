{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonda do Tenancy",
  "version": "0.0.1",
  "identifier": "com.novasce.TenancySonda",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1431",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Sonda do Tenancy (teste)",
        "width": 1264,
        "height": 728,
        "minWidth": 1024,
        "minHeight": 728,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
